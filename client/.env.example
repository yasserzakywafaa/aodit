# Development
CI=true
PORT=1600
HTTPS=false
BROWSER=none
ESLINT_NO_DEV_ERRORS=true

# Custom App Variables (REACT_APP_ prefix is exposed to client code via Vite's envPrefix)
REACT_APP_PORT=1600
REACT_APP_SERVER_PORT=16000
REACT_APP_ENV=local
# REACT_APP_ENV=production

# URLs
REACT_APP_DEV_API_URL=https://api-dev.aodit.ai
REACT_APP_PROD_API_URL=https://api.aodit.ai

# Tracking
REACT_APP_GOOGLE_ANALYTICS_ID=
