# Development
CI=true
PORT=1600
HTTPS=false
BROWSER=none
# NODE_ENV=development
ESLINT_NO_DEV_ERRORS=true
SKIP_PREFLIGHT_CHECK=false

# Custom CRA Variables
REACT_APP_PORT=1600
REACT_APP_SERVER_PORT=16000
REACT_APP_ENV=local
# REACT_APP_ENV=production
REACT_APP_IS_DEV_LOCAL_SERVER=true
REACT_APP_DISABLE_LIVE_RELOAD=false

# URLs
REACT_APP_DEV_API_URL=https://api-dev.metriz.ai
REACT_APP_PROD_API_URL=https://api.metriz.ai

# Tracking
REACT_APP_GOOGLE_ANALYTICS_ID=
