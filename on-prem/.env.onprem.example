# =============================================================================
# aodit — On-Premises Environment Configuration
# Bank Deployment — CONFIDENTIAL
#
# Copy this file to .env.onprem and fill in all REQUIRED values before starting.
# Lines beginning with # are comments and are ignored by Docker.
#
# Generate secrets (Linux/macOS):  openssl rand -hex 32
#
# One-command install:  ./install.sh
# Manual start:         docker compose --env-file on-prem/.env.onprem -f on-prem/docker-compose.onprem.yml up -d
# =============================================================================


# =============================================================================
# SECTION 1: MONGODB  [REQUIRED]
# =============================================================================
# Default points at the 'mongodb' service in docker-compose.onprem.yml.
# Replace the entire URI if your bank runs a separate MongoDB instance:
#   mongodb://USER:PASSWORD@your-mongo-host:27017/aodit_prod?authSource=admin
#
# Credentials here MUST match MONGO_INITDB_ROOT_USERNAME/PASSWORD below.
NODE_ENV=production
MONGODB_URI_PROD=mongodb://aodit_user:aodit_prod_Ab3xK9mNpQr2@mongodb:27017/aodit_prod?authSource=admin

# Used by the 'mongodb' Docker service to create the root user on first startup.
MONGO_INITDB_ROOT_USERNAME=aodit_user
MONGO_INITDB_ROOT_PASSWORD=aodit_prod_Ab3xK9mNpQr2


# =============================================================================
# SECTION 2: AUTHENTICATION  [REQUIRED]
# =============================================================================
# Signs and verifies all user session tokens. Minimum 64 hex characters.
# Generate: openssl rand -hex 32
JWT_SECRET=a342692c1393c43889c0ba515befe02f23558b8cb61e11c105f85ffbe87a918c

# Enable on-premises mode.
# When ON_PREM=true:
#   - The login page shows only email + password (Google/Phone options are hidden)
#   - The register page shows a "Contact your IT administrator" message instead
#     of a self-registration form — employees cannot sign up on their own
#   - Admins create all user accounts via Dashboard → Users → "Create User"
ON_PREM=true


# =============================================================================
# SECTION 3: INITIAL ADMIN ACCOUNT  [REQUIRED — run once after first startup]
# =============================================================================
# These vars are ONLY used by the one-time seed script — not by the running app.
# After the stack is up, run the command below ONCE to create the first
# super_admin account. All subsequent users are created via the Dashboard.
#
# Run once after the stack is healthy:
#   docker compose --env-file on-prem/.env.onprem -f on-prem/docker-compose.onprem.yml exec aodit \
#     sh -c "ADMIN_EMAIL=admin@bank.internal \
#            ADMIN_PASSWORD=SecurePass123 \
#            ADMIN_FIRST_NAME=Admin \
#            ADMIN_LAST_NAME=User \
#            node build/scripts/seed-admin.js"
#
# The script is idempotent — it safely skips if the email already exists.
ADMIN_EMAIL=yasserzakywafaa@gmail.com
ADMIN_PASSWORD=Yasser1234567890
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User


# =============================================================================
# SECTION 4: AI / LLM PROVIDER  [REQUIRED]
# =============================================================================
# The application calls an OpenAI-compatible API for all AI features
# (report generation, analysis, web enrichment).
#
# Point OPENROUTER_BASE_URL at your internal LLM server.
# Any OpenAI-compatible endpoint works: Ollama, vLLM, Azure OpenAI, etc.
#
# Examples:
#   Ollama:       http://ollama.bank.internal:11434/v1
#   vLLM:         http://vllm.bank.internal:8000/v1
#   Azure OpenAI: https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOY
#
# If your LLM server requires no API key, set a dummy value (e.g. "none").
OPENROUTER_BASE_URL=dummy
OPENROUTER_API_KEY_PROD=dummy

# The model name as understood by your LLM server.
# Examples: llama3.1:8b, mistral, gpt-4o (Azure), etc.
OPENROUTER_MODEL_NAME=llama3.1:8b

# Model used for web URL enrichment tasks. Set to any model your server supports.
OPENROUTER_WEB_BROWSE_MODEL=llama3.1:8b


# =============================================================================
# SECTION 5: CORS  [REQUIRED]
# =============================================================================
# The internal URL your bank uses to access the application (reverse proxy /
# load balancer address). Multiple origins: comma-separated.
# Example: https://aodit.bank.internal, https://10.0.1.50
PUBLIC_URLS_CLIENT_PROD=http://localhost:16006


# =============================================================================
# SECTION 6: EMAIL — SMTP  [OPTIONAL]
# =============================================================================
# Used for sending welcome emails when new user accounts are created.
# Point at your bank's internal mail relay or SMTP server.
#
# Note: email sending is non-blocking — if left blank, account creation still
# works but no welcome email is sent. Errors are logged, not thrown.
SMTP=smtp.bank.internal
SMTP_PORT=587
EMAIL=aodit-noreply@bank.internal
EMAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
