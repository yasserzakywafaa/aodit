# ============================================================
# Stage 1: Build the React/Vite client
# ============================================================
FROM node:22-alpine AS client-builder

# Install Chromium from Alpine repos (works on both amd64 and arm64)
RUN apk add --no-cache chromium nss freetype harfbuzz ca-certificates ttf-freefont

# Point Puppeteer at the system Chromium; skip the bundled download
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

WORKDIR /app/client
COPY client/package.json client/yarn.lock* ./
RUN yarn install --frozen-lockfile
COPY client/ .

# Leave REACT_APP_PROD_API_URL empty → relative URLs → same-origin on-prem.
# Override with --build-arg REACT_APP_PROD_API_URL=https://api.host for split deploys.
ARG REACT_APP_ENV=production
ARG REACT_APP_PROD_API_URL=""
ARG REACT_APP_GOOGLE_ANALYTICS_ID=""
ENV REACT_APP_ENV=$REACT_APP_ENV
ENV REACT_APP_PROD_API_URL=$REACT_APP_PROD_API_URL
ENV REACT_APP_GOOGLE_ANALYTICS_ID=$REACT_APP_GOOGLE_ANALYTICS_ID

RUN yarn build

# ============================================================
# Stage 2: Build the Express/TypeScript server
# ============================================================
FROM node:22-alpine AS server-builder

WORKDIR /app/server
COPY server/package.json server/yarn.lock* ./
RUN yarn install --frozen-lockfile
COPY server/ .
RUN yarn build
RUN mkdir -p build/services/email && cp -r src/services/email/templates build/services/email/templates

# ============================================================
# Stage 3: Production image
# ============================================================
FROM node:22-alpine

ENV NODE_ENV=production
ENV FRONTEND_BUILD_PATH=/app/public
ENV SERVE_STATIC_CONTENT=true
ENV PORT=16006

WORKDIR /app
COPY server/package.json server/yarn.lock* ./
RUN yarn install --frozen-lockfile --production && yarn cache clean

COPY --from=server-builder /app/server/build ./build
COPY --from=client-builder /app/client/dist ./public

# Security: run as the pre-existing 'node' user (uid 1000) — CIS Docker Benchmark 4.1
RUN chown -R node:node /app
USER node

EXPOSE 16006

# wget is available in node:22-alpine without extra packages
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:16006/api/health || exit 1

CMD ["node", "build/src/server.js"]
