<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>New Contact Form Submission</title>
  <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->
</head>
<body style="margin: 0; padding: 0; font-family: 'Inter', Arial, sans-serif; background-color: #ffffff; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;">
  <!-- Wrapper table for email client compatibility -->
  <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #f5f5f5;">
    <tr>
      <td align="center" style="padding: 40px 20px;">
        <!-- Main content container -->
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" style="max-width: 600px; width: 100%; background-color: #ffffff; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);">
          
          {{> header}}
          
          <!-- Main Content Area -->
          <tr>
            <td style="padding: 0 30px 30px 30px; background-color: #ffffff;">
              <div style="color: #0A0A0A; line-height: 1.6;">
                <!-- Alert Header -->
                <div style="margin: 0 0 30px 0; padding: 15px 20px; background-color: rgba(184, 150, 62, 0.1); border-left: 4px solid #047857;">
                  <h1 style="margin: 0; font-size: 24px; font-weight: 600; color: #8B6914; line-height: 1.2;">
                    New Contact Form Submission
                  </h1>
                </div>
                
                <!-- Sender Information -->
                <div style="margin: 0 0 30px 0;">
                  <h2 style="margin: 0 0 15px 0; font-size: 20px; font-weight: 600; color: #047857;">
                    Sender Details
                  </h2>
                  <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                    <tr>
                      <td style="padding: 8px 0; font-size: 14px; color: #6B6B6B; width: 120px;">
                        <strong style="color: #0A0A0A;">Name:</strong>
                      </td>
                      <td style="padding: 8px 0; font-size: 14px; color: #0A0A0A;">
                        {{name}}
                      </td>
                    </tr>
                    {{#if company}}
                    <tr>
                      <td style="padding: 8px 0; font-size: 14px; color: #6B6B6B;">
                        <strong style="color: #0A0A0A;">Company:</strong>
                      </td>
                      <td style="padding: 8px 0; font-size: 14px; color: #0A0A0A;">
                        {{company}}
                      </td>
                    </tr>
                    {{/if}}
                    <tr>
                      <td style="padding: 8px 0; font-size: 14px; color: #6B6B6B;">
                        <strong style="color: #0A0A0A;">Email:</strong>
                      </td>
                      <td style="padding: 8px 0; font-size: 14px; color: #0A0A0A;">
                        <a href="mailto:{{email}}" style="color: #047857; text-decoration: none;">{{email}}</a>
                      </td>
                    </tr>
                    {{#if role}}
                    <tr>
                      <td style="padding: 8px 0; font-size: 14px; color: #6B6B6B;">
                        <strong style="color: #0A0A0A;">I am a:</strong>
                      </td>
                      <td style="padding: 8px 0; font-size: 14px; color: #0A0A0A;">
                        {{role}}
                      </td>
                    </tr>
                    {{/if}}
                    {{#if reportOfInterest}}
                    <tr>
                      <td style="padding: 8px 0; font-size: 14px; color: #6B6B6B;">
                        <strong style="color: #0A0A0A;">Report of interest:</strong>
                      </td>
                      <td style="padding: 8px 0; font-size: 14px; color: #0A0A0A;">
                        {{reportOfInterest}}
                      </td>
                    </tr>
                    {{/if}}
                  </table>
                </div>
                
                <!-- Message Content -->
                <div style="margin: 0 0 30px 0;">
                  <h2 style="margin: 0 0 15px 0; font-size: 20px; font-weight: 600; color: #047857;">
                    Message
                  </h2>
                  <div style="padding: 20px; background-color: #e1ede8; border-left: 4px solid #047857;">
                    <p style="margin: 0; font-size: 14px; color: #0A0A0A; line-height: 1.6; white-space: pre-wrap;">{{message}}</p>
                  </div>
                </div>
                
                <!-- Reply CTA -->
                <div style="margin: 30px 0 0 0; padding: 20px; background-color: #e1ede8;">
                  <p style="margin: 0 0 15px 0; font-size: 14px; color: #6B6B6B; line-height: 1.6;">
                    <strong style="color: #0A0A0A;">Reply to:</strong> <a href="mailto:{{email}}" style="color: #047857; text-decoration: none;">{{email}}</a>
                  </p>
                  <a href="mailto:{{email}}?subject=Re: Rating request{{#if reportOfInterest}} - {{reportOfInterest}}{{/if}}" 
                     style="display: inline-block; background-color: #047857; color: #0A0A0A; padding: 12px 30px; text-decoration: none; font-weight: 600; font-size: 14px;">
                    Reply via Email
                  </a>
                </div>
              </div>
            </td>
          </tr>
          
          {{> footer}}
          
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
