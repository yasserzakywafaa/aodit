<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>Thank you for contacting us!</title>
  <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->
</head>
<body style="margin: 0; padding: 0; font-family: 'Inter', Arial, sans-serif; background-color: #ffffff; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;">
  <!-- Wrapper table for email client compatibility -->
  <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #f5f5f5;">
    <tr>
      <td align="center" style="padding: 40px 20px;">
        <!-- Main content container -->
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" style="max-width: 600px; width: 100%; background-color: #ffffff; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);">
          
          {{> header}}
          
          <!-- Main Content Area -->
          <tr>
            <td style="padding: 0 30px 30px 30px; background-color: #ffffff;">
              <div style="color: #0A0A0A; line-height: 1.6;">
                <!-- Greeting -->
                <h1 style="margin: 0 0 15px 0; font-size: 32px; font-weight: 700; color: #B8963E; line-height: 1.2; text-align: center;">
                  Thank you for reaching out! 🎉
                </h1>
                
                <!-- Greeting Message -->
                <p style="margin: 0 0 25px 0; font-size: 18px; color: #0A0A0A; text-align: center; font-weight: 500;">
                  Hello {{name}},
                </p>
                
                <!-- Main Message Card -->
                <div style="margin: 0 0 30px 0; padding: 25px;">
                  <p style="margin: 0; font-size: 16px; color: #0A0A0A; line-height: 1.7; text-align: center;">
                   We've received your message and our team is already looking into it. You'll hear back from us soon!
                  </p>
                </div>
                
                {{#if message}}
                <!-- Message Preview -->
                <div style="padding: 25px; border-left: 5px solid #B8963E; box-shadow: 1px 2px 3px rgba(184, 150, 62, 0.15);">
                  <p style="margin-bottom: 16px; font-size: 16px; font-weight: 700; color: #B8963E;">
                    Your Message
                  </p>
                  <div style="padding: 15px; background-color: #ffffff; border: 1px solid #e9ecef;">
                    <p style="margin: 0; font-size: 15px; color: #6B6B6B; line-height: 1.7; white-space: pre-wrap; font-style: italic;">{{message}}</p>
                  </div>
                </div>
                {{/if}}
              </div>
            </td>
          </tr>
          
          {{> footer}}
          
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
