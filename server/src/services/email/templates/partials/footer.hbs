<!-- Footer -->
<tr>
  <td align="center" style="padding: 0;">
    <div
      style="margin: 30px; padding: 20px; background: linear-gradient(135deg, #8e4585 0%, #d6cd76 100%); text-align: center;"
    >
      <p
        style="margin: 0 0 10px 0; font-size: 15px; color: #ffffff; line-height: 1.6; font-weight: 500;"
      >
        Need immediate assistance?
      </p>
      <p
        style="margin: 0; font-size: 14px; color: #ffffff; line-height: 1.6; opacity: 0.95;"
      >
        Don't hesitate to reach out directly - we're here to help! 🚀
      </p>
    </div>
  </td>
</tr>

<tr>
  <td
    style="padding: 30px; background-color: #f8f9fa; border-top: 1px solid #e9ecef;"
  >
    <table
      role="presentation"
      cellspacing="0"
      cellpadding="0"
      border="0"
      width="100%"
    >
      <tr>
        <td align="center" style="padding: 0 0 20px 0;">
          <p
            style="margin: 0; font-size: 14px; color: #666666; line-height: 1.6;"
          >
            Best regards,<br />
            <strong style="color: #8e4585;">The Aodit.ai Team</strong>
          </p>
        </td>
      </tr>
      <tr>
        <td align="center" style="padding: 0 0 20px 0;">
          <p
            style="margin: 0; font-size: 12px; color: #999999; line-height: 1.5;"
            ><a
            <a
              href="{{appUrl}}"
            >Visit Aodit.ai</a>
            {{#if docsUrl}}
              &nbsp;|&nbsp;
              <a
                href="{{docsUrl}}"
                style="color: #8e4585; text-decoration: none;"
              >Documentation</a>
            {{/if}}
          </p>
        </td>
      </tr>
      <tr>
            <td align="center" style="padding: 0;">
          <p
            style="margin: 0; font-size: 11px; color: #999999; line-height: 1.5;"
          >
            ©
            {{currentYear}}
            Aodit.ai. All rights reserved.
          </p>
        </td>
      </tr>
    </table>
  </td>
</tr>
