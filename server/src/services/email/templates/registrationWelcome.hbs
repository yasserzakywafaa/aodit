<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>Welcome to Aodit.ai!</title>
  <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->
</head>
<body style="margin: 0; padding: 0; font-family: 'Inter', Arial, sans-serif; background-color: #ffffff; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;">
  <!-- Wrapper table for email client compatibility -->
  <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #f5f5f5;">
    <tr>
      <td align="center" style="padding: 40px 20px;">
        <!-- Main content container -->
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" style="max-width: 600px; width: 100%; background-color: #ffffff; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);">
          
          {{> header}}
          
          <!-- Main Content Area -->
          <tr>
            <td style="padding: 0 30px 30px 30px; background-color: #ffffff;">
              <div style="color: #0A0A0A; line-height: 1.6;">
                <!-- Greeting -->
                <h1 style="margin: 0 0 20px 0; font-size: 28px; font-weight: 600; color: #C8960C; line-height: 1.2;">
                  Welcome to Aodit.ai! 🎉
                </h1>
                
                <!-- Greeting Message -->
                <p style="margin: 0 0 20px 0; font-size: 16px; color: #0A0A0A;">
                  Hello {{userName}},
                </p>
                
                <!-- Welcome Message -->
                <p style="margin: 0 0 20px 0; font-size: 16px; color: #0A0A0A; line-height: 1.6;">
                  We're thrilled to have you join the Aodit.ai community! You're now ready to create stunning, AI-powered project posts in seconds.
                </p>
                
                <!-- Getting Started -->
                <div style="margin: 30px 0; padding: 20px; background-color: #EDE9E1; border-radius: 8px;">
                  <h2 style="margin: 0 0 15px 0; font-size: 20px; font-weight: 600; color: #C8960C;">
                    Getting Started
                  </h2>
                  <p style="margin: 0 0 15px 0; font-size: 14px; color: #6B6B6B; line-height: 1.6;">
                    Here's how to create your first project post:
                  </p>
                  <ol style="margin: 0; padding-left: 20px; font-size: 14px; color: #6B6B6B; line-height: 1.8;">
                    <li>Enter your project topic or URL</li>
                    <li>Let our AI generate your content</li>
                    <li>Review and customize your project</li>
                    <li>Publish and share with the world!</li>
                  </ol>
                </div>
                
                <!-- CTA Button -->
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 30px 0;">
                  <tr>
                    <td align="center" style="padding: 0;">
                      <a href="{{appUrl}}" 
                         style="display: inline-block; background-color: #C8960C; color: #0A0A0A; padding: 14px 40px; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 16px; line-height: 1.5; text-align: center;">
                        Create Your First Report
                      </a>
                    </td>
                  </tr>
                </table>
                
                <!-- Support Information -->
                <p style="margin: 30px 0 0 0; font-size: 14px; color: #6B6B6B; line-height: 1.6;">
                  {{#if docsUrl}}
                    Need help? Check out our <a href="{{docsUrl}}" style="color: #C8960C; text-decoration: underline;">documentation</a> or reach out to our support team.
                  {{else}}
                    Need help? Reach out to our support team.
                  {{/if}}
                </p>
              </div>
            </td>
          </tr>
          
          {{> footer}}
          
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
